# Copy to .env. The desk runs in local paper mode with every secret left blank.
# Do not commit .env.

# paper (default) or live. Live also requires the Risk page confirmation.
TRADING_MODE=paper

# Paper book and the principal used for return-vs-target. Default 50000.
PAPER_PRINCIPAL=50000

# Which paper venue the majors use: okx (default), kraken, or both.
# Kraken is public futures data plus the local paper engine. No Kraken key is read.
# Live orders stay off. This flag does not enable them.
PAPER_EXCHANGE=okx

# OKX. Leave blank until you create a key. Public market data does not need one.
# Demo trading is the default once a key exists. Set OKX_SIMULATED=false only for real orders.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com
OKX_SIMULATED=true

# GMGN. Leave blank to hide on-chain trends instead of showing fake prices.
# GMGN_PRIVATE_KEY signs API requests. It is not a wallet key. Paste the PEM, with \n for newlines, or use a single line.
# GMGN_WALLET_ADDRESS is required only for a live swap.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
GMGN_WALLET_ADDRESS=
GMGN_HOST=https://openapi.gmgn.ai
GMGN_TRADING=paper
